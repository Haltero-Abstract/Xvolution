;=====================================================================
; SHOTEMUP.S - vertical shoot'em up, Falcon 030 + DSP (v0.1)
;   Inspired by Wings of Death (Thalion, 1990) : top view, vertical
;   scrolling, a little robot-ship that evolves (3 forms).
;   3D maths by the DSP : R3D.P56 (OUTILS\R3D.A56, from RICK3D), loaded
;   with Simplet's replay (AMIGADSP.P56) ; DSP3D.S = RICK3D's interface.
;   If the DSP does not answer, the 030 draws the top faces only.
;
;   Keys : joystick port 1 (left) or arrows + SPACE, ESC = quit, P = pause,
;          H = bottom bar (fps, mode, coordinates) on / off,
;          D = 3D by the DSP / by the 030
;   Settings : PARAMS.S
;=====================================================================

                ; (labels are case-sensitive)
                include 'PARAMS.S'

                section text
start:
                dc.w    $a000                   ; 6x6 TOS font (Line-A),
                move.l  (a1),a1                 ;  like RICK3D (bottom bar)
                move.w  36(a1),fontfirst
                move.l  72(a1),fontoff
                move.l  76(a1),fontdat
                move.w  80(a1),fontw
                clr.l   -(sp)                   ; Super
                move.w  #32,-(sp)
                trap    #1
                addq.l  #6,sp
                move.l  d0,oldssp

                move.l  #scrbuf+255,d0          ; 2 screens, 256-aligned
                and.l   #$ffffff00,d0
                move.l  d0,scr_phys
                add.l   #SCRSZ,d0
                move.l  d0,scr_log

                move.w  #2,-(sp)                ; Physbase
                trap    #14
                addq.l  #2,sp
                move.l  d0,oldphys
                move.w  #3,-(sp)                ; Logbase
                trap    #14
                addq.l  #2,sp
                move.l  d0,oldlog
                move.w  #-1,-(sp)               ; Vsetmode(-1)
                move.w  #88,-(sp)
                trap    #14
                addq.l  #4,sp
                move.w  d0,oldmode
                move.w  #89,-(sp)               ; Montype : 2 = VGA
                trap    #14
                addq.l  #2,sp
                move.w  #VMODE_VGA,d1
                cmp.w   #2,d0
                beq.s   .vga
                move.w  #VMODE_RGB,d1
.vga:           move.w  d1,vmode

                bsr     clear_screens
                move.w  vmode,-(sp)             ; Setscreen(log,phys,3,mode)
                move.w  #3,-(sp)
                move.l  scr_phys,-(sp)
                move.l  scr_phys,-(sp)
                move.w  #5,-(sp)
                trap    #14
                lea     14(sp),sp

                bsr     d3dinit                 ; DSP : Simplet + R3D
                tst.w   d0
                bne.s   .nodsp
                move.w  #1,dspok
.nodsp:         bsr     d3dload                 ; R3D answers -> d3don = 1

                bsr     joy_install
                bsr     game_reset

main_loop:
                bsr     game_update
                move.l  scr_log,a6
                bsr     render
                bsr     countfps
                move.w  #-1,-(sp)               ; Setscreen(-1,log,-1) :
                move.l  scr_log,-(sp)           ;  shown at the next VBL
                move.l  #-1,-(sp)
                move.w  #5,-(sp)
                trap    #14
                lea     12(sp),sp
                move.w  #37,-(sp)               ; Vsync
                trap    #14
                addq.l  #2,sp
                move.l  scr_log,d0              ; swap
                move.l  scr_phys,scr_log
                move.l  d0,scr_phys
                bsr     keys
                tst.w   quit
                beq     main_loop

                bsr     joy_remove
                move.w  oldmode,-(sp)           ; screen back
                move.w  #3,-(sp)
                move.l  oldphys,-(sp)
                move.l  oldlog,-(sp)
                move.w  #5,-(sp)
                trap    #14
                lea     14(sp),sp
                move.l  oldssp,-(sp)
                move.w  #32,-(sp)
                trap    #1
                addq.l  #6,sp
                clr.w   -(sp)
                trap    #1

;---------------------------------------------------------------------
; INPUT : our own keyboard interrupt (ACIA, vector $118) : held keys
;   (keys[scancode] = 1 while pressed) + joystick packets ($FF = port 1).
;   Port 0 = mouse, not read.
;   Keyboard : arrows = move, SPACE = fire (like the joystick)
KEY_ESC         equ     $01
KEY_P           equ     $19
KEY_D           equ     $20
KEY_H           equ     $23
KEY_SPC         equ     $39
KEY_UP          equ     $48
KEY_DN          equ     $50
KEY_LT          equ     $4B
KEY_RT          equ     $4D

joy_install:
                lea     keymap,a0
                moveq   #127/4,d0
.c:             clr.l   (a0)+
                dbra    d0,.c
                clr.w   pk_cnt
                pea     ikbd_joy                ; joystick events
                clr.w   -(sp)
                move.w  #25,-(sp)
                trap    #14
                addq.l  #8,sp
                move.w  sr,-(sp)
                move.w  #$2700,sr
                move.l  $118.w,old118
                move.l  #acia_it,$118.w
                move.w  (sp)+,sr
                rts
joy_remove:
                move.w  sr,-(sp)
                move.w  #$2700,sr
                move.l  old118,$118.w
                move.w  (sp)+,sr
                pea     ikbd_mouse              ; mouse back
                clr.w   -(sp)
                move.w  #25,-(sp)
                trap    #14
                addq.l  #8,sp
                rts

acia_it:
                movem.l d0-d1/a0,-(sp)
.nx:            btst    #0,$fffffc00.w          ; byte received ?
                beq.s   .done
                move.b  $fffffc02.w,d0
                tst.w   pk_cnt
                bne.s   .pk
                cmp.b   #$f6,d0
                bhs.s   .hdr
                moveq   #0,d1                   ; key : bit 7 = released
                move.b  d0,d1
                and.w   #$7f,d1
                lea     keymap,a0
                tst.b   d0
                smi     d0
                not.b   d0
                and.b   #1,d0
                move.b  d0,(a0,d1.w)
                bra.s   .nx
.hdr:           move.b  d0,pk_type              ; packet : bytes to skip
                moveq   #0,d1
                move.b  d0,d1
                sub.w   #$f6,d1
                move.b  .len(pc,d1.w),d1
                move.w  d1,pk_cnt
                bra.s   .nx
.pk:            subq.w  #1,pk_cnt
                cmp.b   #$ff,pk_type            ; port 1
                beq.s   .j1
                cmp.b   #$fd,pk_type            ; (both ports : 2nd byte)
                bne.s   .nx
                tst.w   pk_cnt
                bne.s   .nx
.j1:            move.b  d0,joy1
                bra.s   .nx
.done:          btst    #0,$fffffc04.w          ; (MIDI : byte dropped)
                beq.s   .dn
                move.b  $fffffc06.w,d0
.dn:            movem.l (sp)+,d0-d1/a0
                bclr    #6,$fffffa11.w          ; end of the ACIA interrupt
                rte
.len:           dc.b    7,5,2,2,2,2,6,2,1,1     ; $F6..$FF
                even

; read_input : joystick port 1 + keyboard -> joyin (bits 0 up 1 down
;   2 left 3 right 7 fire)
read_input:
                lea     keymap,a0
                move.b  joy1,d0
                tst.b   KEY_UP(a0)
                beq.s   .1
                bset    #0,d0
.1:             tst.b   KEY_DN(a0)
                beq.s   .2
                bset    #1,d0
.2:             tst.b   KEY_LT(a0)
                beq.s   .3
                bset    #2,d0
.3:             tst.b   KEY_RT(a0)
                beq.s   .4
                bset    #3,d0
.4:             tst.b   KEY_SPC(a0)
                beq.s   .5
                bset    #7,d0
.5:             move.b  d0,joyin
                rts

; keys : ESC quit, P pause, D DSP / 030 (on the press only)
keys:
                lea     keymap,a0
                lea     keyold,a1
                tst.b   KEY_ESC(a0)
                beq.s   .p
                move.w  #1,quit
.p:             move.b  KEY_P(a0),d0
                cmp.b   (a1),d0
                beq.s   .d
                move.b  d0,(a1)
                tst.b   d0
                beq.s   .d
                eor.w   #1,paused
.d:             move.b  KEY_D(a0),d0
                cmp.b   1(a1),d0
                beq.s   .x
                move.b  d0,1(a1)
                tst.b   d0
                beq.s   .x
                bsr     d3dkey
.x:             move.b  KEY_H(a0),d0            ; H : bottom bar on / off
                cmp.b   2(a1),d0
                beq.s   .y
                move.b  d0,2(a1)
                tst.b   d0
                beq.s   .y
                eor.w   #1,txt_hidden
.y:             rts

;---------------------------------------------------------------------
game_reset:
                clr.l   score
                move.w  #NB_LIVES,lives
                clr.w   form
                clr.w   px
                move.w  #80,py
                move.w  #INVUL_T,inv
                clr.w   firet
                clr.w   kills
                clr.w   gover
                clr.w   bon_act
                move.w  #60,wavet
                move.l  #100000,gpos
                lea     bullets,a0
                move.w  #MAXB*4-1,d0
.b:             clr.w   (a0)+
                dbra    d0,.b
                lea     enemies,a0
                move.w  #MAXE*8-1,d0
.e:             clr.w   (a0)+
                dbra    d0,.e
                rts

game_update:
                tst.w   paused
                bne     .x
                move.l  gpos,d0                 ; ground scrolls down
                sub.l   #SCROLL_SPD,d0
                cmp.l   #1000,d0
                bgt.s   .g
                move.l  #100000,d0
.g:             move.l  d0,gpos
                tst.w   gover
                beq.s   .play
                subq.w  #1,gover
                bne     .x
                bsr     game_reset
                bra     .x
.play:          bsr     upd_player
                bsr     upd_bullets
                bsr     upd_enemies
                bsr     upd_bonus
                bsr     collide
.x:             rts

upd_player:
                bsr     read_input
                move.b  joyin,d0
                move.w  px,d1
                move.w  py,d2
                btst    #2,d0
                beq.s   .m1
                subq.w  #SHIP_SPD,d1
.m1:             btst    #3,d0
                beq.s   .m2
                addq.w  #SHIP_SPD,d1
.m2:             btst    #0,d0
                beq.s   .m3
                subq.w  #SHIP_SPD,d2
.m3:             btst    #1,d0
                beq.s   .m4
                addq.w  #SHIP_SPD,d2
.m4:             cmp.w   #-SHIP_XMAX,d1
                bge.s   .m5
                move.w  #-SHIP_XMAX,d1
.m5:             cmp.w   #SHIP_XMAX,d1
                ble.s   .m6
                move.w  #SHIP_XMAX,d1
.m6:             cmp.w   #-SHIP_YMAX,d2
                bge.s   .m7
                move.w  #-SHIP_YMAX,d2
.m7:             cmp.w   #SHIP_YMAX,d2
                ble.s   .m8
                move.w  #SHIP_YMAX,d2
.m8:             move.w  d1,px
                move.w  d2,py
                tst.w   inv
                beq.s   .i
                subq.w  #1,inv
.i:             tst.w   firet
                beq.s   .f
                subq.w  #1,firet
                rts
.f:             btst    #7,d0
                beq     .r
                move.w  form,d3
                cmp.w   #1,d3
                beq.s   .f1
                bgt.s   .f2
                move.w  px,d1                   ; form 0 : 1 bullet
                move.w  py,d2
                sub.w   #14,d2
                moveq   #0,d3
                bsr     add_bullet
                move.w  #FIRE_T0,firet
                rts
.f1:            move.w  px,d1                   ; form 1 : 2 bullets
                subq.w  #8,d1
                move.w  py,d2
                subq.w  #8,d2
                moveq   #0,d3
                bsr     add_bullet
                add.w   #16,d1
                bsr     add_bullet
                move.w  #FIRE_T0,firet
                rts
.f2:            move.w  px,d1                   ; form 2 : fan of 3
                move.w  py,d2
                sub.w   #16,d2
                moveq   #0,d3
                bsr     add_bullet
                sub.w   #12,d1
                addq.w  #6,d2
                moveq   #-2,d3
                bsr     add_bullet
                add.w   #24,d1
                moveq   #2,d3
                bsr     add_bullet
                move.w  #FIRE_T2,firet
.r:             rts

; add_bullet : d1 = x, d2 = y, d3 = dx (kept)
add_bullet:
                movem.l d0/a0,-(sp)
                lea     bullets,a0
                moveq   #MAXB-1,d0
.l:             tst.w   (a0)
                beq.s   .f
                addq.l  #8,a0
                dbra    d0,.l
                bra.s   .x
.f:             move.w  #1,(a0)
                movem.w d1-d3,2(a0)
.x:             movem.l (sp)+,d0/a0
                rts

upd_bullets:
                lea     bullets,a0
                moveq   #MAXB-1,d0
.l:             tst.w   (a0)
                beq.s   .n
                sub.w   #BUL_SPD,4(a0)
                move.w  6(a0),d1
                add.w   d1,2(a0)
                cmp.w   #-135,4(a0)
                bgt.s   .n
                clr.w   (a0)
.n:             addq.l  #8,a0
                dbra    d0,.l
                rts

; enemies : 16 bytes : act x y type hp t x0 -
upd_enemies:
                subq.w  #1,wavet
                bne.s   .mv
                move.w  #WAVE_T,wavet
                bsr     spawn_enemy
.mv:            lea     enemies,a0
                moveq   #MAXE-1,d0
.l:             tst.w   (a0)
                beq.s   .n
                tst.w   6(a0)
                bne.s   .t1
                addq.w  #2,4(a0)                ; drone : straight down
                bra.s   .chk
.t1:            addq.w  #1,4(a0)                ; cruiser : slow, zigzag
                addq.w  #1,10(a0)
                move.w  10(a0),d1
                and.w   #127,d1
                cmp.w   #63,d1
                ble.s   .k
                neg.w   d1
                add.w   #127,d1
.k:             sub.w   #32,d1
                add.w   12(a0),d1
                move.w  d1,2(a0)
.chk:           cmp.w   #140,4(a0)
                blt.s   .n
                clr.w   (a0)
.n:             lea     16(a0),a0
                dbra    d0,.l
                rts

spawn_enemy:
                lea     enemies,a0
                moveq   #MAXE-1,d0
.l:             tst.w   (a0)
                beq.s   .f
                lea     16(a0),a0
                dbra    d0,.l
                rts
.f:             bsr     rnd
                move.w  d0,d1
                lsr.w   #7,d1
                and.w   #1,d1
                move.w  d1,6(a0)
                bsr     rnd
                mulu    #240,d0
                swap    d0
                sub.w   #120,d0
                move.w  d0,2(a0)
                move.w  d0,12(a0)
                move.w  #-140,4(a0)
                clr.w   10(a0)
                move.w  #EN_HP0,8(a0)
                tst.w   d1
                beq.s   .h
                move.w  #EN_HP1,8(a0)
.h:             move.w  #1,(a0)
                rts

upd_bonus:
                tst.w   bon_act
                beq.s   .x
                addq.w  #1,bon_y
                cmp.w   #140,bon_y
                blt.s   .x
                clr.w   bon_act
.x:             rts

rnd:            move.w  seed,d0                 ; -> d0.w
                mulu    #25173,d0
                add.l   #13849,d0
                move.w  d0,seed
                rts

;---------------------------------------------------------------------
collide:
                lea     bullets,a0              ; --- bullets / enemies
                moveq   #MAXB-1,d6
.b:             tst.w   (a0)
                beq     .bn
                lea     enemies,a1
                moveq   #MAXE-1,d5
.e:             tst.w   (a1)
                beq.s   .en
                move.w  2(a0),d0
                sub.w   2(a1),d0
                bpl.s   .k1
                neg.w   d0
.k1:             cmp.w   #BUL_R,d0
                bgt.s   .en
                move.w  4(a0),d0
                sub.w   4(a1),d0
                bpl.s   .k2
                neg.w   d0
.k2:             cmp.w   #BUL_R,d0
                bgt.s   .en
                clr.w   (a0)                    ; hit
                subq.w  #1,8(a1)
                bgt.s   .bn
                bsr     kill_enemy
                bra.s   .bn
.en:            lea     16(a1),a1
                dbra    d5,.e
.bn:            addq.l  #8,a0
                dbra    d6,.b

                tst.w   inv                     ; --- ship / enemies
                bne.s   .bon
                lea     enemies,a1
                moveq   #MAXE-1,d5
.p:             tst.w   (a1)
                beq.s   .pn
                move.w  px,d0
                sub.w   2(a1),d0
                bpl.s   .k3
                neg.w   d0
.k3:             cmp.w   #HIT_R,d0
                bgt.s   .pn
                move.w  py,d0
                sub.w   4(a1),d0
                bpl.s   .k4
                neg.w   d0
.k4:             cmp.w   #HIT_R,d0
                bgt.s   .pn
                clr.w   (a1)
                bsr     player_hit
                bra.s   .bon
.pn:            lea     16(a1),a1
                dbra    d5,.p

.bon:           tst.w   bon_act                 ; --- ship / bonus : evolves
                beq.s   .x
                move.w  px,d0
                sub.w   bon_x,d0
                bpl.s   .k5
                neg.w   d0
.k5:             cmp.w   #HIT_R+4,d0
                bgt.s   .x
                move.w  py,d0
                sub.w   bon_y,d0
                bpl.s   .k6
                neg.w   d0
.k6:             cmp.w   #HIT_R+4,d0
                bgt.s   .x
                clr.w   bon_act
                add.l   #PTS_BONUS,score
                cmp.w   #FORM_MAX,form
                bge.s   .x
                addq.w  #1,form
.x:             rts

; kill_enemy : a1 = enemy
kill_enemy:
                clr.w   (a1)
                move.l  #PTS_EN0,d0
                tst.w   6(a1)
                beq.s   .s
                move.l  #PTS_EN1,d0
.s:             add.l   d0,score
                addq.w  #1,kills
                moveq   #0,d0
                move.w  kills,d0
                divu    #BONUS_EVERY,d0
                swap    d0
                tst.w   d0
                bne.s   .x
                tst.w   bon_act
                bne.s   .x
                move.w  #1,bon_act              ; bonus pod where it died
                move.w  2(a1),bon_x
                move.w  4(a1),bon_y
.x:             rts

; player_hit : the ship loses a form ; at form 0, a life
player_hit:
                move.w  #INVUL_T,inv
                tst.w   form
                beq.s   .l
                subq.w  #1,form
                rts
.l:             subq.w  #1,lives
                bgt.s   .x
                clr.w   lives
                move.w  #150,gover              ; game over : 2,5 s then restart
.x:             rts

;---------------------------------------------------------------------
; render : a6 = screen
render:
                bsr     draw_ground
                bsr     draw_pillars
                move.w  #SHIP_Z,mdl_z
                tst.w   bon_act
                beq.s   .ne
                lea     mdl_bonus,a0
                move.w  bon_x,d6
                move.w  bon_y,d7
                bsr     draw_model
.ne:            lea     enemies,a2
                moveq   #MAXE-1,d5
.e:             tst.w   (a2)
                beq.s   .en
                lea     mdl_en0,a0
                tst.w   6(a2)
                beq.s   .e1
                lea     mdl_en1,a0
.e1:            move.w  2(a2),d6
                move.w  4(a2),d7
                bsr     draw_model
.en:            lea     16(a2),a2
                dbra    d5,.e
                lea     bullets,a2
                moveq   #MAXB-1,d5
.b:             tst.w   (a2)
                beq.s   .bn
                move.w  2(a2),d0
                muls    #FOC,d0
                divs    #SHIP_Z,d0
                add.w   #CX,d0
                move.w  4(a2),d1
                muls    #FOC,d1
                divs    #SHIP_Z,d1
                add.w   #CY,d1
                move.w  d0,d2
                addq.w  #1,d2
                subq.w  #1,d0
                move.w  d1,d3
                addq.w  #4,d3
                subq.w  #3,d1
                move.w  #$FFF0,d4
                bsr     fillrect
.bn:            addq.l  #8,a2
                dbra    d5,.b
                tst.w   gover
                bne.s   .np
                move.w  inv,d0                  ; (blinks while invulnerable)
                btst    #2,d0
                bne.s   .np
                lea     forms,a0
                move.w  form,d0
                lsl.w   #2,d0
                move.l  (a0,d0.w),a0
                move.w  px,d6
                move.w  py,d7
                bsr     draw_model
.np:            bsr     draw_hud
                bsr     draw_band               ; bottom bar (H)
                rts

; draw_model : a0 = model (x0 y0 x1 y1 z0 z1 .w, colours .l ; -99 = end),
;   d6 / d7 = position, mdl_z = depth
draw_model:
                movem.l d0-d7/a0-a1,-(sp)
.l:             move.w  (a0)+,d0
                cmp.w   #-99,d0
                beq.s   .x
                move.w  (a0)+,d1
                move.w  (a0)+,d2
                move.w  (a0)+,d3
                move.w  (a0)+,d4
                move.w  (a0)+,d5
                move.l  (a0)+,a1
                add.w   d6,d0
                add.w   d6,d2
                add.w   d7,d1
                add.w   d7,d3
                add.w   mdl_z,d4
                add.w   mdl_z,d5
                bsr     draw_box
                bra.s   .l
.x:             movem.l (sp)+,d0-d7/a0-a1
                rts

; draw_box : box d0=X0 d1=Y0 d2=X1 d3=Y1 d4=Z0 (near) d5=Z1, a1 = colours
;   (front, side, top, bottom), a6 = screen. All registers kept.
draw_box:
                movem.l d0-d7/a0-a6,-(sp)
                tst.w   d3don
                beq.s   .cpu
                bsr     d3dbox                  ; DSP : side faces drawn
                tst.w   d7
                bmi.s   .cpu                    ; (DSP lost : 030)
                beq.s   .x
                move.w  (a1),d4                 ; front face (projected)
                bsr     fillrect
                bra.s   .x
.cpu:           muls    #FOC,d0                 ; 030 : front face only
                divs    d4,d0
                add.w   #CX,d0
                muls    #FOC,d2
                divs    d4,d2
                add.w   #CX,d2
                muls    #FOC,d1
                divs    d4,d1
                add.w   #CY,d1
                muls    #FOC,d3
                divs    d4,d3
                add.w   #CY,d3
                move.w  (a1),d4
                bsr     fillrect
.x:             movem.l (sp)+,d0-d7/a0-a6
                rts

; fillrect : d0,d1 - d2,d3 (inclusive), d4.w = colour, a6 = screen
fillrect:
                movem.l d0-d7/a0-a1,-(sp)
                tst.w   d0
                bpl.s   .q1
                moveq   #0,d0
.q1:             cmp.w   #SCR_W-1,d2
                ble.s   .q2
                move.w  #SCR_W-1,d2
.q2:             cmp.w   d2,d0
                bgt.s   .x
                cmp.w   clip_y0,d1
                bge.s   .q3
                move.w  clip_y0,d1
.q3:             cmp.w   clip_y1,d3
                ble.s   .q4
                move.w  clip_y1,d3
.q4:             sub.w   d1,d3                   ; lines - 1
                bmi.s   .x
                move.w  d4,d5
                swap    d5
                move.w  d4,d5
                sub.w   d0,d2
                addq.w  #1,d2                   ; width
                moveq   #0,d6
                move.w  d1,d6
                mulu    #LINEB,d6
                lea     (a6,d6.l),a0
                add.w   d0,d0
                adda.w  d0,a0
.ln:            move.l  a0,a1
                move.w  d2,d7
                btst    #1,d0                   ; (long words aligned)
                beq.s   .al
                move.w  d4,(a1)+
                subq.w  #1,d7
                beq.s   .nl
.al:            move.w  d7,d6
                lsr.w   #1,d6
                beq.s   .r
                subq.w  #1,d6
.lp:            move.l  d5,(a1)+
                dbra    d6,.lp
.r:             btst    #0,d7
                beq.s   .nl
                move.w  d4,(a1)+
.nl:            lea     LINEB(a0),a0
                dbra    d3,.ln
.x:             movem.l (sp)+,d0-d7/a0-a1
                rts

;---------------------------------------------------------------------
; draw_ground : tiles of TILE_PX pixels, a river that meanders (2D, 030)
draw_ground:
                movem.l d0-d7/a0-a1,-(sp)
                move.l  a6,a0
                moveq   #0,d7                   ; line
                move.w  #-1,lastrow
.ln:            move.l  gpos,d0
                add.l   d7,d0
                divu    #TILE_PX,d0             ; d0.w = row, high = line in the tile
                move.l  d0,d1
                swap    d1
                tst.w   d1
                bne.s   .norm
                move.l  #(SEAM<<16)|SEAM,d2     ; seam between two rows
                moveq   #19,d3
.s:             rept    8
                move.l  d2,(a0)+
                endr
                dbra    d3,.s
                bra.s   .nx
.norm:          cmp.w   lastrow,d0
                beq.s   .same
                move.w  d0,lastrow
                bsr     row_colors
.same:          lea     rowcol,a1
                moveq   #15,d3
                move.l  #(SEAM<<16)|SEAM,d4
.t:             move.l  (a1)+,d2
                move.l  d4,(a0)+                ; seam (2 pixels)
                rept    9
                move.l  d2,(a0)+
                endr
                dbra    d3,.t
.nx:            addq.w  #1,d7
                cmp.w   #SCR_H,d7
                blt     .ln
                movem.l (sp)+,d0-d7/a0-a1
                rts

; river : column of the river for row d0 -> d1 (3 .. 10)
river_col:
                move.w  d0,d1
                lsr.w   #2,d1
                and.w   #15,d1
                cmp.w   #7,d1
                ble.s   .k
                neg.w   d1
                add.w   #15,d1
.k:             addq.w  #3,d1
                rts

; row_colors : d0.w = row -> rowcol (16 tiles, colour on 2 pixels)
row_colors:
                movem.l d0-d6/a1-a2,-(sp)
                move.w  d0,d5
                bsr     river_col
                move.w  d1,d6
                lea     rowcol,a1
                lea     grnd_pal,a2
                moveq   #0,d4
.c:             move.w  d4,d1
                sub.w   d6,d1
                cmp.w   #1,d1
                bhi.s   .land
                move.w  #WATER,d2
                bra.s   .st
.land:          moveq   #0,d1
                move.w  d5,d1
                mulu    #37,d1
                moveq   #0,d2
                move.w  d4,d2
                mulu    #101,d2
                add.l   d2,d1
                move.l  d1,d2
                lsr.l   #5,d2
                eor.l   d2,d1
                and.w   #3,d1
                add.w   d1,d1
                move.w  (a2,d1.w),d2
.st:            move.w  d2,d3
                swap    d3
                move.w  d2,d3
                move.l  d3,(a1)+
                addq.w  #1,d4
                cmp.w   #16,d4
                blt.s   .c
                movem.l (sp)+,d0-d6/a1-a2
                rts

; draw_pillars : 3D pillars standing on the ground (one every PIL_EVERY rows)
draw_pillars:
                movem.l d0-d7/a1,-(sp)
                move.l  gpos,d0
                divu    #TILE_PX,d0
                move.w  d0,d7
                subq.w  #1,d7                   ; first row (above the screen)
                moveq   #13,d6
.r:             moveq   #0,d0
                move.w  d7,d0
                divu    #PIL_EVERY,d0
                swap    d0
                tst.w   d0
                bne     .nx
                move.w  d7,d0
                bsr     river_col               ; d1 = river (not on it)
                move.w  d7,d0                   ; column
                mulu    #13,d0
                and.w   #15,d0
                move.w  d0,d2
                sub.w   d1,d2
                cmp.w   #1,d2
                bhi.s   .c0
                move.w  d1,d0
                addq.w  #4,d0
.c0:            cmp.w   #1,d0
                bge.s   .c1
                moveq   #1,d0
.c1:            cmp.w   #14,d0
                ble.s   .c2
                moveq   #14,d0
.c2:            moveq   #0,d1                   ; y on the screen
                move.w  d7,d1
                mulu    #TILE_PX,d1
                sub.l   gpos,d1
                cmp.w   #-40,d1
                blt     .nx
                cmp.w   #SCR_H+20,d1
                bgt     .nx
                mulu    #TILE_PX,d0
                move.w  d0,d4                   ; x on the screen
                move.w  d1,d5
                move.w  d4,d0                   ; -> world at GROUND_Z
                add.w   #3-CX,d0
                muls    #GROUND_Z,d0
                divs    #FOC,d0
                move.w  d4,d2
                add.w   #TILE_PX-4-CX,d2
                muls    #GROUND_Z,d2
                divs    #FOC,d2
                move.w  d5,d1
                add.w   #3-CY,d1
                muls    #GROUND_Z,d1
                divs    #FOC,d1
                move.w  d5,d3
                add.w   #TILE_PX-4-CY,d3
                muls    #GROUND_Z,d3
                divs    #FOC,d3
                move.w  #PIL_Z0,d4
                move.w  #GROUND_Z,d5
                lea     col_pil,a1
                bsr     draw_box
.nx:            addq.w  #1,d7
                dbra    d6,.r
                movem.l (sp)+,d0-d7/a1
                rts

;---------------------------------------------------------------------
; draw_hud : score (6 digits), form of the ship, lives
draw_hud:
                movem.l d0-d7,-(sp)
                move.l  score,d0
                moveq   #8,d1
                moveq   #6,d2
                bsr     draw_num
                moveq   #0,d7                   ; form : 1 to 3 yellow bars
.f:             move.w  d7,d0
                lsl.w   #3,d0
                add.w   #148,d0
                move.w  d0,d2
                addq.w  #5,d2
                moveq   #6,d1
                moveq   #15,d3
                move.w  #$FFE0,d4
                bsr     fillrect
                addq.w  #1,d7
                cmp.w   form,d7
                ble.s   .f
                move.w  lives,d7                ; lives : green squares
                beq.s   .go
                subq.w  #1,d7
.l:             move.w  d7,d0
                mulu    #10,d0
                neg.w   d0
                add.w   #304,d0
                move.w  d0,d2
                addq.w  #6,d2
                moveq   #7,d1
                moveq   #13,d3
                move.w  #$07E0,d4
                bsr     fillrect
                dbra    d7,.l
.go:            tst.w   gover                   ; game over : red band
                beq.s   .x
                move.w  gover,d0
                btst    #4,d0
                bne.s   .x
                moveq   #0,d0
                move.w  #110,d1
                move.w  #SCR_W-1,d2
                move.w  #129,d3
                move.w  #$F800,d4
                bsr     fillrect
.x:             movem.l (sp)+,d0-d7
                rts

; draw_num : d0.l = value, d1 = x, d2 = y (digits 3x5, pixels 2x2, white)
draw_num:
                movem.l d0-d7/a0-a2,-(sp)
                cmp.l   #999999,d0
                bls.s   .c
                move.l  #999999,d0
.c:             divu    #1000,d0
                lea     digbuf+6,a0
                move.l  d0,d3
                clr.w   d3
                swap    d3
                bsr.s   .three
                moveq   #0,d3
                move.w  d0,d3
                bsr.s   .three
                lea     digbuf,a0
                moveq   #5,d7
.dg:            moveq   #0,d3
                move.b  (a0)+,d3
                mulu    #5,d3
                lea     font,a1
                adda.w  d3,a1
                move.w  d2,d5
                moveq   #4,d6
.row:           move.b  (a1)+,d3
                moveq   #0,d0
                move.w  d5,d0
                mulu    #LINEB,d0
                lea     (a6,d0.l),a2
                move.w  d1,d0
                add.w   d0,d0
                adda.w  d0,a2
                btst    #2,d3
                beq.s   .c1
                move.l  #-1,(a2)
                move.l  #-1,LINEB(a2)
.c1:            btst    #1,d3
                beq.s   .c2
                move.l  #-1,4(a2)
                move.l  #-1,LINEB+4(a2)
.c2:            btst    #0,d3
                beq.s   .c3
                move.l  #-1,8(a2)
                move.l  #-1,LINEB+8(a2)
.c3:            addq.w  #2,d5
                dbra    d6,.row
                addq.w  #8,d1
                dbra    d7,.dg
                movem.l (sp)+,d0-d7/a0-a2
                rts
.three:         moveq   #2,d4                   ; d3 = 0..999 -> 3 digits before a0
.t:             divu    #10,d3
                swap    d3
                move.b  d3,-(a0)
                clr.w   d3
                swap    d3
                dbra    d4,.t
                rts

;=====================================================================
; BOTTOM BAR (like RICK3D's TEXTE.S) : 2 lines of the 6x6 TOS font,
;   white on the darkened picture ; H hides it.
;   line 1 : FPS, 3D by DSP / 030, form, lives, pause
;   line 2 : ship X Y, enemies, bullets, kills, bonus, ground row
;=====================================================================
countfps:
                addq.w  #1,fpscnt
                move.l  $4ba.w,d0               ; 200 Hz clock
                move.l  d0,d1
                sub.l   fpsclk,d1
                cmp.l   #200,d1
                blo.s   .out
                move.l  d0,fpsclk
                move.w  fpscnt,fps
                clr.w   fpscnt
.out:           rts

build_lines:
                lea     linebuf,a0
                move.w  #2*LINEW-1,d0
.sp:            move.b  #' ',(a0)+
                dbra    d0,.sp
                lea     linebuf,a0              ; --- line 1
                lea     t_fps,a1
                bsr     puts
                move.w  fps,d0
                bsr     fmtnum
                bsr     puts
                lea     t_mode,a1
                bsr     puts
                lea     t_m030,a1
                tst.w   d3don
                beq.s   .m
                lea     t_mdsp,a1
.m:             bsr     puts
                tst.w   dspok
                bne.s   .d
                lea     t_nodsp,a1
                bsr     puts
.d:             lea     t_form,a1
                bsr     puts
                move.w  form,d0
                lsl.w   #2,d0
                lea     t_forms,a1
                move.l  (a1,d0.w),a1
                bsr     puts
                lea     t_lives,a1
                bsr     puts
                move.w  lives,d0
                bsr     fmtnum
                bsr     puts
                tst.w   inv
                beq.s   .p
                lea     t_inv,a1
                bsr     puts
.p:             tst.w   paused
                beq.s   .l2
                lea     t_pause,a1
                bsr     puts
.l2:            lea     linebuf+LINEW,a0        ; --- line 2
                lea     t_x,a1
                bsr     puts
                move.w  px,d0
                bsr     fmtsnum
                bsr     puts
                lea     t_y,a1
                bsr     puts
                move.w  py,d0
                bsr     fmtsnum
                bsr     puts
                lea     enemies,a1              ; objects on screen
                moveq   #MAXE-1,d1
                moveq   #0,d0
.ce:            tst.w   (a1)
                beq.s   .ce1
                addq.w  #1,d0
.ce1:           lea     16(a1),a1
                dbra    d1,.ce
                lea     t_en,a1
                bsr     puts1
                lea     bullets,a1
                moveq   #MAXB-1,d1
                moveq   #0,d0
.cb:            tst.w   (a1)
                beq.s   .cb1
                addq.w  #1,d0
.cb1:           addq.l  #8,a1
                dbra    d1,.cb
                lea     t_bul,a1
                bsr     puts1
                move.w  kills,d0
                lea     t_kill,a1
                bsr     puts1
                lea     t_bon,a1
                bsr     puts
                move.b  #'-',d0
                tst.w   bon_act
                beq.s   .b
                move.b  #'*',d0
.b:             move.b  d0,(a0)+
                lea     t_row,a1
                bsr     puts
                move.l  gpos,d0
                divu    #TILE_PX,d0
                bsr     fmtnum
                bra     puts

; puts1 : label a1 then the number d0
puts1:          move.w  d0,-(sp)
                bsr.s   puts
                move.w  (sp)+,d0
                bsr.s   fmtnum
                bra.s   puts

; copies the string a1 (without the final 0) to a0
puts:           move.b  (a1)+,d0
                beq.s   .x
                move.b  d0,(a0)+
                bra.s   puts
.x:             rts

; d0.w -> decimal digits, a1 = start of the string (end = 0)
fmtnum:
                lea     numbuf+8,a1
                clr.b   (a1)
                and.l   #$ffff,d0
.d:             divu    #10,d0
                swap    d0
                add.b   #'0',d0
                move.b  d0,-(a1)
                clr.w   d0
                swap    d0
                tst.w   d0
                bne.s   .d
                rts
; fmtsnum : signed
fmtsnum:
                tst.w   d0
                bpl.s   fmtnum
                neg.w   d0
                bsr.s   fmtnum
                move.b  #'-',-(a1)
                rts

; draw_band : the bar at the bottom of the screen a6 (darkened + text)
draw_band:
                tst.w   txt_hidden
                bne     .out
                movem.l d0-d7/a0-a5,-(sp)
                bsr     build_lines
                move.l  #TXT_Y*LINEB,d0
                lea     (a6,d0.l),a1
                move.l  a1,a5                   ; top of the bar
                move.l  #$7bef7bef,d2
                move.w  #BAND_H*LINEB/4-1,d0
.dk:            move.l  (a1),d1                 ; colour / 2 (2 pixels)
                lsr.l   #1,d1
                and.l   d2,d1
                move.l  d1,(a1)+
                dbra    d0,.dk
                lea     linebuf,a2
                lea     LINEB+2(a5),a4          ; line 1 : y+1, x=1
                bsr.s   .line
                lea     linebuf+LINEW,a2
                lea     8*LINEB+2(a5),a4        ; line 2 : y+8
                bsr.s   .line
                movem.l (sp)+,d0-d7/a0-a5
.out:           rts
.line:          moveq   #COLS-1,d7
.ch:            moveq   #0,d0
                move.b  (a2)+,d0
                cmp.w   #' ',d0
                bls.s   .nc
                sub.w   fontfirst,d0
                bmi.s   .nc
                add.w   d0,d0
                move.l  fontoff,a1
                move.w  (a1,d0.w),d3            ; x of the character (bits)
                move.w  d3,d0
                lsr.w   #3,d0
                move.l  fontdat,a1
                adda.w  d0,a1
                and.w   #7,d3
                move.l  a4,a3
                moveq   #5,d4                   ; 6 lines
.fl:            move.b  (a1),d2
                lsl.w   #8,d2
                move.b  1(a1),d2
                lsl.w   d3,d2
                moveq   #5,d5                   ; 6 pixels : bits 15..10
                move.l  a3,a0
.pb:            add.w   d2,d2
                bcc.s   .p0
                move.w  #$ffff,(a0)
.p0:            addq.l  #2,a0
                dbra    d5,.pb
                lea     LINEB(a3),a3
                adda.w  fontw,a1
                dbra    d4,.fl
.nc:            lea     12(a4),a4               ; next column (6 pixels)
                dbra    d7,.ch
                rts

clear_screens:
                lea     scrbuf,a0
                move.l  #(SCRSZ*2+256)/4-1,d0
.c:             clr.l   (a0)+
                subq.l  #1,d0
                bpl.s   .c
                rts

; (used by DSP3D.S : RICK3D's back view, not here)
bvx_add:        rts

                include 'DSP3D.S'
                include 'AMIGADSP.S'

;=====================================================================
                section data
                even
grnd_pal:       dc.w    $32C4,$4385,$7286,$5249 ; grass, light grass, dirt, rock
ikbd_joy:       dc.b    $14                     ; joystick events
ikbd_mouse:     dc.b    $08                     ; mouse back (relative)
                even
box_mask:       dc.w    15                      ; faces allowed (DSP3D.S)
clip_y0:        dc.w    0
clip_y1:        dc.w    SCR_H-1
seed:           dc.w    $1234
t_d3don:        dc.b    '3D : DSP',0
t_d3doff:       dc.b    '3D : 030',0
t_d3dno:        dc.b    'NO DSP',0
t_fps:          dc.b    'FPS ',0
t_mode:         dc.b    '  3D ',0
t_mdsp:         dc.b    'DSP',0
t_m030:         dc.b    '030',0
t_nodsp:        dc.b    ' (NO DSP)',0
t_form:         dc.b    '  FORM ',0
t_f0:           dc.b    'PROBE',0
t_f1:           dc.b    'FIGHTER',0
t_f2:           dc.b    'HEAVY',0
t_lives:        dc.b    '  LIVES ',0
t_inv:          dc.b    '  INVUL',0
t_pause:        dc.b    '  PAUSE',0
t_x:            dc.b    'X ',0
t_y:            dc.b    ' Y ',0
t_en:           dc.b    '  ENEMIES ',0
t_bul:          dc.b    '  BULLETS ',0
t_kill:         dc.b    '  KILLS ',0
t_bon:          dc.b    '  BONUS ',0
t_row:          dc.b    '  ROW ',0
                even
t_forms:        dc.l    t_f0,t_f1,t_f2
                even

; colours : front (top of the object), side, top edge, bottom edge
col_hull:       dc.w    $587F,$2A1A,$3B3C,$18D0
col_cock:       dc.w    $FFE0,$C600,$E700,$8400
col_wing:       dc.w    $C618,$8410,$A514,$630C
col_eng:        dc.w    $FC00,$B260,$D340,$8180
col_red:        dc.w    $F800,$9800,$C000,$6000
col_dark:       dc.w    $8410,$4208,$630C,$2104
col_purp:       dc.w    $C01F,$780F,$9013,$480A
col_bon:        dc.w    $FFE0,$C600,$E700,$8400
col_glow:       dc.w    $07FF,$03EF,$05F7,$0210
col_pil:        dc.w    $8C51,$528A,$738E,$4208

; models : x0 y0 x1 y1 z0 z1 (z0 = near face, relative to SHIP_Z),
;   colours ; the farthest boxes first ; -99 = end
forms:          dc.l    mdl_f0,mdl_f1,mdl_f2
mdl_f0:                                         ; form 0 : probe
                dc.w    -9,2,-5,8,4,10
                dc.l    col_eng
                dc.w    5,2,9,8,4,10
                dc.l    col_eng
                dc.w    -2,-12,2,-7,2,8
                dc.l    col_wing
                dc.w    -5,-7,5,7,0,10
                dc.l    col_hull
                dc.w    -2,-4,2,1,-3,0
                dc.l    col_cock
                dc.w    -99
mdl_f1:                                         ; form 1 : fighter
